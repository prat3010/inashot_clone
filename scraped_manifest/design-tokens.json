  "keyframes": {
    "swiper-preloader-spin": "@keyframes swiper-preloader-spin { \n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}",
    "underline-toggle": "@keyframes underline-toggle { \n  0% { background-size: 100% 5%; background-position: right 90%; }\n  50% { background-size: 0% 5%; background-position: right 90%; }\n  51% { background-size: 0% 5%; background-position: left 90%; }\n  100% { background-size: 100% 5%; background-position: left 90%; }\n}",
    "fadeInWord": "@keyframes fadeInWord { \n  0% { opacity: 0; transform: translateY(20px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}",
    "animateAccountOpen": "@keyframes animateAccountOpen { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}",
    "popupOpenFade": "@keyframes popupOpenFade { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}",
    "popupExitFade": "@keyframes popupExitFade { \n  0% { opacity: 1; }\n  100% { opacity: 0; }\n}",
    "popupOpenSlide": "@keyframes popupOpenSlide { \n  0% { transform: translate3d(0px, 100vh, 0px); visibility: visible; }\n  100% { transform: translateZ(0px); }\n}",
    "popupExitSlide": "@keyframes popupExitSlide { \n  0% { transform: translateZ(0px); }\n  100% { visibility: hidden; transform: translate3d(0px, 100vh, 0px); }\n}",
    "popupOpenZoom": "@keyframes popupOpenZoom { \n  0% { opacity: 0; transform: scale(1.1); }\n  100% { opacity: 1; transform: scale(1); }\n}",
    "popupExitZoom": "@keyframes popupExitZoom { \n  0% { opacity: 1; transform: scale(1); }\n  100% { opacity: 0; transform: scale(0.9); }\n}",
    "popupOpenSlideFade": "@keyframes popupOpenSlideFade { \n  0% { opacity: 0; transform: translate3d(0px, 4rem, 0px); visibility: visible; }\n  100% { opacity: 1; transform: translateZ(0px); }\n}",
    "popupExitSlideFade": "@keyframes popupExitSlideFade { \n  0% { opacity: 1; transform: translateZ(0px); }\n  100% { opacity: 0; visibility: hidden; transform: translate3d(0px, 4rem, 0px); }\n}",
    "barBottomOpenSlide": "@keyframes barBottomOpenSlide { \n  0% { transform: translate3d(0px, 120%, 0px); visibility: visible; }\n  100% { transform: translateZ(0px); }\n}",
    "barBottomExitSlide": "@keyframes barBottomExitSlide { \n  0% { transform: translateZ(0px); }\n  100% { visibility: hidden; transform: translate3d(0px, 120%, 0px); }\n}",
    "barBottomOpenSlideFade": "@keyframes barBottomOpenSlideFade { \n  0% { opacity: 0; transform: translate3d(0px, 4rem, 0px); visibility: visible; }\n  100% { opacity: 1; transform: translateZ(0px); }\n}",
    "barBottomExitSlideFade": "@keyframes barBottomExitSlideFade { \n  0% { opacity: 1; transform: translateZ(0px); }\n  100% { opacity: 0; visibility: hidden; transform: translate3d(0px, 4rem, 0px); }\n}",
    "fadeInUp": "@keyframes fadeInUp { \n  0% { opacity: 0; transform: translateY(10px); }\n  100% { opacity: 1; transform: translateY(0px); }\n}",
    "rotator": "@keyframes rotator { \n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(270deg); }\n}",
    "dash": "@keyframes dash { \n  0% { stroke-dashoffset: 280; }\n  50% { stroke-dashoffset: 75; transform: rotate(135deg); }\n  100% { stroke-dashoffset: 280; transform: rotate(450deg); }\n}",
    "close-pulse": "@keyframes close-pulse { \n  0% { transform: scale(1); }\n  50% { transform: scale(0.8); }\n  100% { transform: scale(1); }\n}",
    "recipientFormOpen": "@keyframes recipientFormOpen { \n  0% { opacity: 0; transform: translateY(-1rem); }\n  100% { opacity: 1; transform: translateY(0px); }\n}",
    "closingAnim": "@keyframes closingAnim { \n  0% { opacity: 1; }\n  100% { opacity: 0; }\n}",
    "jdgm-spin": "@keyframes jdgm-spin { \n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(359deg); }\n}",
    "marquee": "@keyframes marquee { \n  0% { transform: translate(0px); }\n  100% { transform: translate(-100%); }\n}",
    "swap": "@keyframes swap { \n  0%, 50% { left: 0%; }\n  50.01%, 100% { left: 100%; }\n}",
    "marquee-rtl": "@keyframes marquee-rtl { \n  0% { transform: translate(0px); }\n  100% { transform: translate(100%); }\n}",
    "swap-rtl": "@keyframes swap-rtl { \n  0%, 50% { right: 0%; }\n  50.01%, 100% { right: 100%; }\n}",
    "spin": "@keyframes spin { \n  0% { transform: rotate(0deg); }\n  100% { transform: rotate(360deg); }\n}",
    "bounceIn": "@keyframes bounceIn { \n  20%, 40%, 60%, 80%, 0%, 100% { animation-timing-function: cubic-bezier(0.215, 0.61, 0.355, 1); }\n  0% { opacity: 0; transform: scale3d(0.3, 0.3, 0.3); }\n  20% { transform: scale3d(1.1, 1.1, 1.1); }\n  40% { transform: scale3d(0.9, 0.9, 0.9); }\n  60% { opacity: 1; transform: scale3d(1.03, 1.03, 1.03); }\n  80% { transform: scale3d(0.97, 0.97, 0.97); }\n  100% { opacity: 1; transform: scaleZ(1); }\n}",
    "image-carousel-marquee": "@keyframes image-carousel-marquee { \n  0% { transform: translate(0px); }\n  100% { transform: translate(-100%); }\n}",
    "image-carousel-swap": "@keyframes image-carousel-swap { \n  0%, 50% { left: 0%; }\n  50.01%, 100% { left: 100%; }\n}",
    "linksFadeIn": "@keyframes linksFadeIn { \n  0% { opacity: 0; }\n  100% { opacity: 1; }\n}",
    "rzp-rot": "@-webkit-keyframes rzp-rot { \n  100% { transform: rotate(360deg); }\n}"
  },
